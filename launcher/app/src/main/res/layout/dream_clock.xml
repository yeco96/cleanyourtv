<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock and date that drift around a black screen over an ambient glow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The glow is its background; clock_wallpaper puts the picture in it, cropped like Home's. -->
    <ImageView
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:shadowColor="#D9000000"
                android:shadowRadius="16"
                android:shadowDy="2"
                android:textColor="#E6FFFFFF"
                android:textSize="120sp"
                android:fontFamily="@string/font_extralight"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:shadowColor="#D9000000"
                android:shadowRadius="16"
                android:shadowDy="2"
                android:textColor="#99FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:shadowColor="#D9000000"
            android:shadowRadius="16"
            android:shadowDy="2"
            android:textColor="#D9FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />
    </LinearLayout>

    <!-- tmdb_backdrops: the film behind the clock, small and soft in the bottom left corner. Hidden otherwise. -->
    <LinearLayout
        android:id="@+id/dreamCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="40dp"
        android:alpha="0"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/dreamCaptionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@string/font_medium"
            android:maxLines="1"
            android:shadowColor="#D9000000"
            android:shadowRadius="12"
            android:shadowDy="1"
            android:textColor="#E6FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/dreamCaptionFacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@string/font_medium"
            android:maxLines="1"
            android:shadowColor="#D9000000"
            android:shadowRadius="10"
            android:shadowDy="1"
            android:textColor="#FFFFD700"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dreamCaptionOverview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@string/font_regular"
            android:maxLines="2"
            android:shadowColor="#D9000000"
            android:shadowRadius="10"
            android:shadowDy="1"
            android:textColor="#BFE2E8F0"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
